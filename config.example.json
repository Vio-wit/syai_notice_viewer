{
  "base_url": "http://lb.tec.suda.edu.cn",
  "sso_base": "https://sso.tec.suda.edu.cn",
  "service_url": "http://lb.tec.suda.edu.cn/login",
  "credentials_file": "",
  "notice_types": ["notice", "fw", "xngs"],
  "max_items_per_type": 200,
  "download_attachments": true,
  "max_attachment_bytes": 52428800,
  "request_interval_seconds": 0.5,
  "user_agent": "Personal-College-Notice-Viewer/0.1",
  "collection_start_date": "",
  "bind_host": "127.0.0.1",
  "port": 8765,
  "notifications": {
    "enabled": true,
    "desktop": false
  },
  "ai": {
    "enabled": false,
    "auto_brief": false,
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4o-mini",
    "api_key": "",
    "timeout_seconds": 90,
    "max_tokens": 2400,
    "max_input_chars": 40000
  },
  "professional": {
    "enabled": false,
    "profile_name": "academy-news",
    "site_url": "https://example.edu",
    "entry_url": "https://example.edu/news",
    "allowed_domains": ["example.edu"],
    "include_url_patterns": ["https://example.edu/news/**"],
    "exclude_url_patterns": ["**/login/**", "**/logout**", "**/signout**"],
    "auth": {
      "type": "NONE",
      "login_url": "",
      "username": "",
      "password": "",
      "username_field": "username",
      "password_field": "password",
      "token": "",
      "header_name": "Authorization",
      "token_prefix": "Bearer ",
      "headers": {}
    },
    "parser": {
      "type": "HTML",
      "title_selector": "h1",
      "published_selector": ".publish-date",
      "department_selector": ".department",
      "content_selector": "article",
      "include_selectors": [],
      "remove_selectors": ["script", "style", "nav", "header", "footer"],
      "attachment_selectors": [],
      "json_paths": {"title": "title", "published": "publishedAt", "department": "department", "content": "content"},
      "pagination_rules": []
    },
    "security": {
      "same_origin_only": true,
      "private_network_enabled": false,
      "private_network_allowlist": [],
      "verify_tls": true,
      "respect_robots_txt": true,
      "allow_redirects": true,
      "max_redirects": 5
    },
    "limits": {
      "max_depth": 2,
      "max_pages": 100,
      "max_run_seconds": 900,
      "max_response_bytes": 10485760,
      "max_attachment_bytes": 52428800,
      "max_total_bytes": 268435456,
      "request_interval_ms": 500,
      "connect_timeout_seconds": 10,
      "read_timeout_seconds": 30,
      "retry_count": 2
    },
    "output": {
      "download_attachments": true,
      "incremental_enabled": true,
      "dedup_strategy": "URL_CONTENT_HASH",
      "published_from": "",
      "published_to": "",
      "user_agent": "Personal-College-Notice-Viewer/Professional/1.0"
    },
    "logout": {"enabled": false, "url": "", "method": "GET"}
  }
