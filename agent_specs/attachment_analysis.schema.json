{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "学院通知附件纪要",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "key_points",
    "deadlines",
    "required_materials",
    "audience",
    "evidence",
    "status",
    "confidence",
    "source"
  ],
  "properties": {
    "summary": {"type": "string", "maxLength": 3000},
    "key_points": {
      "type": "array",
      "items": {"type": "string", "maxLength": 500},
      "maxItems": 30
    },
    "deadlines": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "event", "evidence"],
        "properties": {
          "date": {"type": "string", "maxLength": 80},
          "event": {"type": "string", "maxLength": 300},
          "evidence": {"type": "string", "maxLength": 500}
        }
      }
    },
    "required_materials": {
      "type": "array",
      "items": {"type": "string", "maxLength": 500},
      "maxItems": 30
    },
    "audience": {
      "type": "array",
      "items": {"type": "string", "maxLength": 100},
      "maxItems": 10
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string", "maxLength": 500},
      "maxItems": 30
    },
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "needs_ocr", "failed", "rule_baseline"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source": {"type": "string", "pattern": "^(agent:|rules-).+"},
    "model": {"type": "string", "maxLength": 100}
  }
}
